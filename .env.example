# Default local development mode. Valid values: dev, disabled, token.
AIONCORE_AUTH_MODE=dev

# Optional local bootstrap token for token-mode startup only.
# Must be at least 24 characters when set.
AIONCORE_BOOTSTRAP_ADMIN_TOKEN=replace-with-local-bootstrap-token-min-24-chars

# Optional static dashboard hosting from disk under /ui/.
AIONCORE_DASHBOARD_STATIC_DIR=apps/aion-dashboard

# Storage backend selection. Leave unset or set to memory for the default MVP path.
AIONCORE_STORAGE_BACKEND=memory

# Required only when AIONCORE_STORAGE_BACKEND=postgres.
AIONCORE_DATABASE_URL=postgres://aioncore:change-me@localhost:5432/aioncore

# Opt-in dynamic connector workers. Disabled by default.
AIONCORE_CONNECTOR_WORKERS_ENABLED=false

# Opt-in local MQTT ingestion worker. Disabled by default.
AIONCORE_MQTT_ENABLED=false
AIONCORE_MQTT_BROKER_URL=mqtt://127.0.0.1:1883
AIONCORE_MQTT_CLIENT_ID=aioncore-ingest
AIONCORE_MQTT_TOPIC_FILTER=aioncore/+/+/data
AIONCORE_MQTT_PAYLOAD_FORMAT=senml-json
AIONCORE_MQTT_USERNAME=replace-with-local-mqtt-username
AIONCORE_MQTT_PASSWORD=replace-with-local-mqtt-password

# Optional PostgreSQL adapter test database.
AIONCORE_TEST_DATABASE_URL=postgres://aioncore:change-me@localhost:5432/aioncore_test

# Optional TTN live validation test toggles. Test-only; do not use real secrets here.
AIONCORE_TEST_TTN_LIVE=0
AIONCORE_TEST_TTN_BROKER_URL=mqtt://example-ttn-broker:1883
AIONCORE_TEST_TTN_TOPIC_FILTER=v3/example-app/devices/+/up
AIONCORE_TEST_TTN_USERNAME=replace-with-ttn-username
AIONCORE_TEST_TTN_PASSWORD=replace-with-ttn-password-or-api-token
AIONCORE_TEST_TTN_APPLICATION_ID=example-app
AIONCORE_TEST_TTN_DEVICE_ID=example-device
